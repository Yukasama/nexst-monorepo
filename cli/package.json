{
  "name": "create-nexst-monorepo",
  "version": "0.1.0",
  "description": "Scaffold a Next.js + NestJS monorepo with bun, turbo, oxlint, vitest, Prisma, Docker, kustomize and CI",
  "keywords": ["create", "monorepo", "nextjs", "nestjs", "bun", "template"],
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-nexst-monorepo": "dist/index.js"
  },
  "files": [
    "dist",
    "template"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "scripts": {
    "build": "bun build src/index.ts --target=node --outfile dist/index.js",
    "prepack": "bun run build && bun scripts/pack-template.ts",
    "postpack": "rm -rf template",
    "lint": "oxlint",
    "lint:ts": "tsc --noEmit",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:matrix": "bun scripts/verify-matrix.ts"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/node": "^26.6.3",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
