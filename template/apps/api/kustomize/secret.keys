# Allowlist for scripts/seal-secret.sh: only these keys from .env are sealed
# into nexst-api-secret. Everything else is plain config and belongs in
# kustomize/*/application.properties — the Secret is mounted after the
# ConfigMap (envFrom), so any extra key sealed here would override it.
DATABASE_URL
# @if auth
BETTER_AUTH_SECRET
GOOGLE_CLIENT_SECRET
RESEND_API_KEY
# @endif
# @if r2
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
# @endif
