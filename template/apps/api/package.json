{
  "name": "@nexst/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#tests/*": "./tests/*"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint:ts": "tsc --noEmit",
    "lint:error-codes": "! grep -rnE \"new (BadRequestException|NotFoundException|ConflictException|ForbiddenException|UnauthorizedException|UnprocessableEntityException|InternalServerErrorException|ServiceUnavailableException)\\(\" src --include=\"*.ts\" --exclude=\"*.spec.ts\" --exclude-dir=generated",
    "unused": "knip --no-config-hints",
    "auth:generate": "better-auth generate --config scripts/auth.cli.ts -y",
    "db:generate": "bunx --bun prisma generate",
    "db:push": "bunx --bun prisma db push",
    "db:migrate": "bunx --bun prisma migrate dev",
    "db:reset": "bunx --bun prisma migrate reset --force",
    "test:unit": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@apollo/utils.keyvaluecache": "^4.0.0",
    "@as-integrations/fastify": "^3.1.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.5",
    "@nestjs/apollo": "^14.0.2",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/graphql": "^14.0.2",
    "@nestjs/platform-fastify": "^12.1.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nexst/queues": "workspace:*",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client-runtime-utils": "^7.10.0",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "better-auth": "^1.7.6",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.5",
    "graphql": "^17.0.2",
    "ioredis": "6.0.0",
    "js-yaml": "^5.4.2",
    "nestjs-pino": "^5.2.1",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.30.0",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.0",
    "@prisma/client": "^7.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "@types/nodemailer": "^8.0.2",
    "aws-sdk-client-mock": "^4.1.0",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.10.0"
  }
}
