# Copy to .env.development (bun loads it automatically in dev) and fill in.
NODE_ENV=development
LOG_LEVEL=debug
PORT=3001

DATABASE_URL=postgresql://nexst_user:test-pw@localhost:5432/nexst_db?schema=nexst_user
# @if auth

# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
BETTER_AUTH_URL=http://localhost:3001
# Mail goes to MailHog (http://localhost:8025) outside production.
MAIL_SMTP_HOST=localhost
# RESEND_API_KEY=
# @endif
# @if r2

R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nexst
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://cdn.example.com
# @endif
# @if worker

REDIS_HOST=localhost
REDIS_PORT=6379
# @endif
